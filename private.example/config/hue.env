# Philips Hue bridge on your home network.
# Get a user: press the bridge button, then within 30 s run
#   curl -s -X POST -d '{"devicetype":"nightstand#kindle"}' http://BRIDGE_IP/api
# List lamp IDs:  curl -s http://BRIDGE_IP/api/USER/lights
HUE_BRIDGE=192.168.1.20
HUE_USER=paste-the-username
HUE_LAMPS="1 2"
# Shown in the app ("Lights · Bedroom")
ROOM_NAME="Bedroom"
